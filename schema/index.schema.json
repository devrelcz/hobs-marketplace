{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cdn.jsdelivr.net/gh/devrelcz/hobs-marketplace@v1/schema/index.schema.json",
  "title": "Hobs marketplace index",
  "description": "The catalog Hermes Hobs lists. Each entry is a card; the full team lives at its path.",
  "type": "object",
  "required": ["schema", "teams"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "path", "name", "summary", "members"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "path": { "type": "string", "pattern": "^teams/[a-z0-9-]+/team\\.json$" },
          "name": { "$ref": "team.schema.json#/definitions/text" },
          "summary": { "$ref": "team.schema.json#/definitions/text" },
          "members": { "type": "integer", "minimum": 2, "maximum": 6 },
          "tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
